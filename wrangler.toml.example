# Cloudflare Worker 部署样例（Tripo API 中转 + 网页）。复制成 wrangler.toml 再改；详细步骤见 docs/TRIPO.md。
# 密钥不要写在这个文件里，用：npx wrangler secret put TRIPO_API_KEY
# 本地 `npx wrangler dev` 时的密钥放 .dev.vars（已在 .gitignore 里），不要提交。
#
# 注意：中转里的限流计数在内存里，只在单个 Worker 实例里有效，挡不住分散到很多实例的盗刷。
# 正式上线要换成 Durable Objects 或 KV（见 docs/TRIPO.md），并且一定要设 TRIPO_MAX_TASKS_PER_DAY 之外的兜底：
# 在 Tripo 控制台只给这个测试账号充够演示用的积分。

name = "community-planets"
main = "server/tripo/worker.mjs"
compatibility_date = "2026-10-01"

# ---------- 方案 A：同一个 Worker 既托管网页又做中转（推荐，同源，不用配跨域） ----------
# 先 npm run build，dist/ 整个作为静态资源上传；/api/* 先进 Worker，其余请求直接走静态资源
[assets]
directory = "./dist"
binding = "ASSETS"
run_worker_first = ["/api/*"]
# 旧版 wrangler 不支持数组写法时改成 run_worker_first = true（所有请求先进 Worker，worker.mjs 会把非接口请求转给 ASSETS）

[vars]
ALLOWED_ORIGINS = ""                                 # 方案 A 同源，留空
TRIPO_MAX_TASKS_PER_DAY = "50"                       # 滚动 24 小时内最多 50 个生成任务（所有人合计）
TRIPO_MAX_TASKS_PER_IP_PER_HOUR = "5"                # 每个 IP 每小时 5 个
MOCK_MODEL_URL = "/models/tufted-armchair.glb"       # 模拟模式下载的模型（从 dist/ 里取）
MOCK_PREVIEW_URL = "/thumbs/tufted-armchair.webp"
# TRIPO_MOCK = "1"                                   # 先用模拟模式把部署走通，确认没问题再删掉这一行

# ---------- 方案 B：Worker 只做中转，网页放在别处（任意静态托管） ----------
# 1. 删掉上面整个 [assets] 段；
# 2. ALLOWED_ORIGINS 写网页的地址，比如 ALLOWED_ORIGINS = "https://planets.example.com"；
# 3. 构建网页时设 VITE_TRIPO_PROXY=https://community-planets.<你的子域>.workers.dev，再把 dist/ 传到静态托管；
# 4. MOCK_MODEL_URL 写成网页那边的完整地址，比如 "https://planets.example.com/models/tufted-armchair.glb"。
