{
  "name": "gbn",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "start": "node server/tripo/node-server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "seed": "node scripts/build-seed.mjs",
    "prep": "node scripts/prep-models.mjs",
    "shot": "node scripts/shot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cf:dev": "npm run build && npx --yes wrangler@4.156.0 dev --env= --var TRIPO_MOCK:1",
    "cf:check": "npm run build && npx --yes wrangler@4.156.0 deploy --dry-run --env= && npx --yes wrangler@4.156.0 deploy --dry-run --env v2",
    "cf:deploy": "npm run build && npx --yes wrangler@4.156.0 deploy --env=",
    "cf:deploy:v2": "npm run build && npx --yes wrangler@4.156.0 deploy --env v2",
    "cf:tail": "npx --yes wrangler@4.156.0 tail --env=",
    "cf:tail:v2": "npx --yes wrangler@4.156.0 tail --env v2"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "three": "0.186.1",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
