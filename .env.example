# Tripo API 中转的环境变量模板。只有服务端读这些变量，不会进前端包。
# 本地：复制成 .env.local 再填（.env.local 已在 .gitignore 里，不进仓库）。
# 部署：在主机上设同名的环境变量；Cloudflare Worker 用 `npx --yes wrangler@4.156.0 secret put TRIPO_API_KEY`（第二版再加 `--env v2`）和 wrangler.toml 的 [vars]。
# 值留空 = 用默认值。默认值和详细说明见 docs/TRIPO.md。
# 进程环境变量的优先级最高（高于这些文件）：自测时请带 TRIPO_MOCK=1 跑。

# Tripo 的 API 密钥（Tripo 开放平台控制台里创建）。不设就是模拟模式，不花额度。千万不要起名 VITE_TRIPO_API_KEY。
TRIPO_API_KEY=

# 设成 1：强制模拟模式，有密钥也不调 Tripo。
TRIPO_MOCK=

# 全局上限：滚动 24 小时内最多建多少个生成任务（所有 IP 合计）。设 0 = 关掉生成（应急开关）。
TRIPO_MAX_TASKS_PER_DAY=

# 每个 IP 每小时最多建多少个生成任务。
TRIPO_MAX_TASKS_PER_IP_PER_HOUR=

# 每个 IP 每小时最多上传多少张图。
TRIPO_MAX_UPLOADS_PER_IP_PER_HOUR=

# 每个 IP 每分钟最多请求多少次（所有接口合计，轮询也算）。会场多人共用一个出口 IP 时调大。
TRIPO_MAX_REQUESTS_PER_IP_PER_MINUTE=

# 单张图最大多少 MB（不能超过 Tripo 的上限 20）。
TRIPO_MAX_IMAGE_MB=

# 允许跨域调用的网页来源，逗号分隔，例如 https://planets.example.com。留空 = 只允许同源。
ALLOWED_ORIGINS=

# 允许前端选的模型版本，逗号分隔。留空 = 只放行 H 系列（P 系列一个任务 100 积分起，默认不放行）。
TRIPO_MODEL_VERSIONS=

# 前端没指定模型版本时用哪个。
TRIPO_DEFAULT_MODEL_VERSION=

# Tripo API 基地址。留空 = 国际区；中国区账号填中国区的地址（见 docs/TRIPO.md）。
TRIPO_API_BASE=

# 结果文件额外允许的主机，逗号分隔。默认只放行 tripo3d.ai、tripo3d.com 及其子域名。
TRIPO_DOWNLOAD_HOSTS=

# 结果文件最大多少 MB。
TRIPO_MAX_DOWNLOAD_MB=

# 模拟模式用的模型（Node 和 Vite 插件）：相对 public/ 或 dist/ 的路径。
TRIPO_MOCK_MODEL_FILE=

# 模拟模式用的模型和预览图地址（Cloudflare Worker）。
MOCK_MODEL_URL=
MOCK_PREVIEW_URL=

# 独立 Node 服务（npm start）：端口、监听地址、静态文件目录。
PORT=
HOST=
STATIC_DIR=

# 独立 Node 服务前面有几层自己的反向代理（Nginx、平台负载均衡）。直连填 0；有一层填 1，才会按 X-Forwarded-For 认客户端 IP。
TRUST_PROXY=
